{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.npmrc)",
      "Read(./laravel-vision/deploy/deploy.env)",
      "Read(./laravel-vision/storage/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ]
  }
}
