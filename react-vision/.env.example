# API backend
VITE_API_URL=/api
VITE_USE_MOCKS=false

# Reverb (broadcast)
VITE_REVERB_APP_KEY=vision-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# Prefiks ścieżki WebSocketa. Lokalnie PUSTY — przeglądarka łączy się wprost
# z kontenerem Reverba na :8080. Na produkcji `/ws` (nginx proxuje /ws/ → 127.0.0.1:8080).
VITE_REVERB_PATH=

# Web Push (VAPID public key — paste the value generated by VAPID::createVapidKeys() on the backend).
VITE_VAPID_PUBLIC_KEY=
