# ══════════════════════════════════════════════════════════════════════════════
# Vision — SZABLON produkcyjnego .env
#
# TEN PLIK JEST W REPO. Nie wpisuj tu żadnych realnych haseł ani kluczy —
# wszystkie wartości sekretne zostawiamy puste. Realny, wypełniony plik trzymamy
# w deploy/.env.production (gitignored) i/lub prosto w private/.env na serwerze.
#
# Na serwerze: server-init.sh kopiuje ten szablon do private/.env przy pierwszym
# uruchomieniu i przerywa, żebyś uzupełnił wartości. Potem odpalasz go ponownie.
#
# ── JAK UZUPEŁNIAĆ (kolejność ma znaczenie) ───────────────────────────────────
#
#  1. APP_KEY            → zostaw puste, wygeneruje `php8.4 artisan key:generate`
#                          (server-init.sh robi to sam, gdy widzi APP_KEY=)
#  2. DB_*               → HestiaCP → WEB → Database → Add Database.
#                          Hestia prefiksuje nazwy kontem głównym, więc dostaniesz
#                          np. `webmaster_vision`. Użyj nazwy, którą pokaże panel.
#  3. REDIS_PASSWORD     → Redis na tym serwerze jest WSPÓŁDZIELONY i ma globalne
#                          hasło. Podejrzyj je w .env innego działającego projektu
#                          na tej maszynie (np. mineralui-backend). Nie generuj nowego.
#  4. REDIS_DB /
#     REDIS_CACHE_DB     → numery DB muszą być UNIKALNE na serwerze. Zajęte pary
#                          sprawdź w .env sąsiednich projektów (Vector siedzi na 3/4).
#                          Zanim wybierzesz, `redis-cli -a <hasło> INFO keyspace`.
#                          NIE zostawiaj pustych — Laravel wyśle wtedy SELECT ''
#                          i połączenie padnie. Muszą być liczbami.
#  5. REVERB_APP_*       → wygeneruj losowo, np.:
#                            php -r "echo bin2hex(random_bytes(6)),PHP_EOL;"   # APP_ID
#                            php -r "echo bin2hex(random_bytes(16)),PHP_EOL;"  # APP_KEY
#                            php -r "echo bin2hex(random_bytes(32)),PHP_EOL;"  # APP_SECRET
#                          REVERB_APP_KEY MUSI być identyczne z VITE_REVERB_APP_KEY
#                          w react-vision/.env.production — inaczej handshake WS padnie.
#  6. VAPID_*            → jednorazowo, na serwerze:
#                            php8.4 artisan tinker
#                            >>> Minishlink\WebPush\VAPID::createVapidKeys()
#                          publicKey → tutaj ORAZ jako VITE_VAPID_PUBLIC_KEY we froncie,
#                          privateKey → tylko tutaj.
#  7. GOOGLE_* /
#     FACEBOOK_*         → tylko jeśli włączasz social login (routes/oauth.php ma
#                          /oauth/social/{provider}/*). Redirect URI trzeba dopisać
#                          w Google Cloud Console / Facebook Developers.
#                          Zostaw puste, żeby wyłączyć.
#  8. MAIL_*             → dane skrzynki z HestiaCP → MAIL.
#
# Hasła ze znakami specjalnymi (#, $, spacja, nawiasy) MUSZĄ być w cudzysłowach:
#   DB_PASSWORD="xY7_Przyklad(2Q#a"
# Bez nich `#` ucina resztę linii jako komentarz i dostajesz puste hasło.
#
# Po każdej zmianie .env na serwerze: `php8.4 artisan config:cache`.
# ══════════════════════════════════════════════════════════════════════════════

APP_NAME=Vision
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vision.banzamel.pl
APP_OAUTH_URL=https://vision.banzamel.pl
WEBSITE_URL=https://vision.banzamel.pl
# false = kreator /install jest otwarty. Finalize wizarda przestawia to na true.
APP_INSTALLED=false
APP_TIMEZONE=Europe/Warsaw
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en

AUTH_GUARD=api

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ──────────────────────────────────────────────────────────────────────────────
# Database — HestiaCP prefiksuje nazwy kontem głównym (webmaster_*).
# ──────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=""

# ──────────────────────────────────────────────────────────────────────────────
# Redis — WSPÓŁDZIELONY z innymi projektami na tym serwerze.
#
# Izolacja stoi na trzech rzeczach naraz i wszystkie trzy są wymagane:
#   REDIS_PREFIX  — prefiks kluczy (bez niego cache dwóch appek nadpisuje się nawzajem)
#   REDIS_DB / REDIS_CACHE_DB — osobne numery baz (chroni przed cudzym FLUSHDB)
#   REDIS_QUEUE   — nazwana kolejka; z domyślnym `default` worker Vision zjadłby
#                   joby innego projektu stojącego na tym samym numerze DB
# ──────────────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=""
REDIS_PREFIX=vision_
REDIS_DB=
REDIS_CACHE_DB=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_QUEUE=vision-default

# ──────────────────────────────────────────────────────────────────────────────
# File storage — domyślny disk wskazuje storage/app/private,
# czyli tam gdzie kamery wgrywają zdjęcia przez FTP. Nic dodatkowego nie trzeba.
# ──────────────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ──────────────────────────────────────────────────────────────────────────────
# Social login (Socialite) — opcjonalne. Puste = wyłączone.
# Redirect URI musi być 1:1 z tym, co wpisane u dostawcy.
# ──────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://vision.banzamel.pl/oauth/social/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=https://vision.banzamel.pl/oauth/social/facebook/callback

# ──────────────────────────────────────────────────────────────────────────────
# Broadcasting / Reverb (WebSocket)
# ──────────────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# true tylko przy wielu instancjach Reverba spiętych przez Redis pub/sub.
# Jeden proces pod supervisorem = false.
REVERB_SCALING_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────────
# Web Push (VAPID) — para kluczy generowana RAZ, ta sama w obu plikach:
#   VAPID_PUBLIC_KEY (tutaj)  =  VITE_VAPID_PUBLIC_KEY (react-vision/.env.production)
#   VAPID_PRIVATE_KEY (tutaj) — tylko backend
# Zmiana pary unieważnia wszystkie istniejące subskrypcje push w przeglądarkach.
# ──────────────────────────────────────────────────────────────────────────────
VAPID_SUBJECT=mailto:rafalpolak@banzamel.pl
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Mail — używane przez:
#   - UserWelcomeMail        (email z danymi do logowania po utworzeniu konta)
#   - UserPasswordResetMail  (email z nowym hasłem po resecie)
#
# Maile lecą przez kolejkę (vision-queue:* w supervisorze), więc HTTP request
# kończy się natychmiast, a SMTP-latency nie blokuje użytkownika.
#
# `log` zapisuje treść do storage/logs/laravel.log — przydatne do testów.
# Na prawdziwy ruch przepnij na `smtp` i wpisz parametry serwera SMTP.
# ──────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.vision.banzamel.pl
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="no-reply@vision.banzamel.pl"
MAIL_FROM_NAME="Vision"
