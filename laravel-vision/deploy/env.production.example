# Vision production .env — na serwerze kopiujemy do private/.env
# (czyli /home/webmaster/web/vision.banzamel.pl/private/.env — folder, do którego
# PhpStorm wysyła całe laravel-vision/). Robi to server-init.sh przy pierwszym uruchomieniu.
# After editing, run: php artisan key:generate (writes APP_KEY)

APP_NAME=Vision
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vision.banzamel.pl
APP_OAUTH_URL=https://vision.banzamel.pl
WEBSITE_URL=https://vision.banzamel.pl
APP_INSTALLED=false
APP_TIMEZONE=Europe/Warsaw
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en

AUTH_GUARD=api

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ──────────────────────────────────────────────────────────────────────────────
# Database
#
# HestiaCP automatycznie prefiksuje nazwy DB i userów nazwą głównego konta
# (np. main user `webmaster` → DB `webmaster_vision`, user `webmaster_vision_app`).
# Najpierw stwórz bazę przez panel: WEB → Database → Add Database — Hestia
# pokaże Ci finalną nazwę z prefixem, której wymaga MySQL grant.
# ──────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────
# Redis
#
# Systemowy Redis na tym serwerze ma globalne hasło — sprawdź w innych projektach
# które już działają (np. mineralui-backend/.env) i użyj tego samego.
# Jeśli serwer ma rozszerzenie `php-redis` (zalecane, szybsze niż predis),
# zostaw REDIS_CLIENT=phpredis. Inaczej zmień na `predis`.
# ──────────────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ──────────────────────────────────────────────────────────────────────────────
# File storage — domyślny disk wskazuje storage/app/private,
# czyli tam gdzie kamery wgrywają zdjęcia przez FTP. Nic dodatkowego nie trzeba.
# ──────────────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ──────────────────────────────────────────────────────────────────────────────
# Broadcasting / Reverb (WebSocket)
#
# Backend publishes do 127.0.0.1:8080, frontend reaches it via wss://host/ws/app/{key}
# (nginx proxy_pass on /ws/ — see deploy/nginx-vision.conf; trailing slash ucina prefiks,
# więc REVERB_SERVER_PATH zostaje puste).
# REVERB_APP_KEY musi być IDENTYCZNE z VITE_REVERB_APP_KEY w react-vision/.env.production,
# a react-vision/.env.production musi mieć VITE_REVERB_PATH=/ws.
# ──────────────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=vision-app-id
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Backend publish-side — queue worker → Reverb (lokalnie po HTTP, Reverb słucha na 127.0.0.1:8080).
# Browser/WSS-side jest osobno w react-vision/.env.production: VITE_REVERB_HOST/PORT/SCHEME.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# ──────────────────────────────────────────────────────────────────────────────
# Web Push (VAPID)
#
# Wygeneruj raz, użyj tej samej pary w obu plikach:
#   - VAPID_PUBLIC_KEY (tutaj)  =  VITE_VAPID_PUBLIC_KEY (react-vision/.env.production)
#   - VAPID_PRIVATE_KEY (tutaj) — tylko backend
# ──────────────────────────────────────────────────────────────────────────────
VAPID_SUBJECT=mailto:rafalpolak@banzamel.pl
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Mail — używane przez:
#   - UserWelcomeMail        (email z danymi do logowania po utworzeniu konta)
#   - UserPasswordResetMail  (email z nowym hasłem po resecie)
#
# Maile lecą przez kolejkę (vision-queue:* w supervisorze), więc HTTP request
# kończy się natychmiast, a SMTP-latency nie blokuje użytkownika.
#
# `log` zapisuje treść do storage/logs/laravel.log — przydatne do testów.
# Na prawdziwy ruch przepnij na `smtp` i wpisz parametry serwera SMTP.
# ──────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.vision.banzamel.pl
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@vision.banzamel.pl"
MAIL_FROM_NAME="Vision"
